{% comment %}
  Shopify-hosted video, YouTube/Vimeo URL, or a poster image.

  Accepts:
  - video, video_url, image, fallback, alt, class
  - autoplay, loop, muted, controls: {Boolean}
  - width, height: fallback dimensions
  - loading
{% endcomment %}
{%- liquid
  assign video_alt = alt | default: ''
  assign video_class = class | default: 'sgym-video'
  assign video_loading = loading | default: 'lazy'
-%}
{%- if video != blank -%}
  {{
    video
    | video_tag:
      image_size: '1600x',
      autoplay: autoplay,
      loop: loop,
      muted: muted,
      controls: controls,
      playsinline: true,
      class: video_class,
      alt: video_alt
  }}
{%- elsif video_url != blank -%}
  {%- if video_url.type == 'youtube' -%}
    <iframe
      src="https://www.youtube.com/embed/{{ video_url.id }}?playsinline=1{% if autoplay %}&autoplay=1&mute=1{% endif %}{% if loop %}&loop=1&playlist={{ video_url.id }}{% endif %}{% unless controls %}&controls=0{% endunless %}"
      class="{{ video_class }} js-youtube"
      allow="autoplay; encrypted-media"
      allowfullscreen
      title="{{ video_alt | escape }}"
    ></iframe>
  {%- else -%}
    <iframe
      src="https://player.vimeo.com/video/{{ video_url.id }}?playsinline=1{% if autoplay %}&autoplay=1&muted=1{% endif %}{% if loop %}&loop=1{% endif %}"
      class="{{ video_class }} js-vimeo"
      allow="autoplay; encrypted-media"
      allowfullscreen
      title="{{ video_alt | escape }}"
    ></iframe>
  {%- endif -%}
{%- else -%}
  {% render 'sgym-picture',
    image: image,
    fallback: fallback,
    alt: video_alt,
    class: video_class,
    width: width,
    height: height,
    loading: video_loading,
    sizes: sizes
  %}
{%- endif -%}
