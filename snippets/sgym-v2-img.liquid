{%- comment -%}
  Photo with a merchant image_picker and a theme-asset fallback.
  image_url/image_tag (srcset) when an image is set; otherwise assets/sgym-v2-{{ file }}.
{%- endcomment -%}
{%- liquid
  assign alt_text = alt | default: ''
  assign css_class = img_class | default: ''
  assign img_loading = loading | default: 'lazy'
  assign img_w = width | default: 800
  assign img_h = height | default: 800
  assign widths_val = widths | default: '240, 360, 540, 720, 960, 1200, 1600, 2000'
  assign sizes_val = sizes | default: '100vw'
-%}
{%- if image != blank and style == blank and panel == blank -%}
  {%- if fetchpriority != blank -%}
    {{
      image
      | image_url: width: 2000
      | image_tag:
        widths: widths_val,
        sizes: sizes_val,
        width: img_w,
        height: img_h,
        alt: alt_text,
        class: css_class,
        loading: img_loading,
        fetchpriority: fetchpriority
    }}
  {%- else -%}
    {{
      image
      | image_url: width: 2000
      | image_tag:
        widths: widths_val,
        sizes: sizes_val,
        width: img_w,
        height: img_h,
        alt: alt_text,
        class: css_class,
        loading: img_loading
    }}
  {%- endif -%}
{%- elsif image != blank -%}
  <img
    src="{{ image | image_url: width: 1600 }}"
    srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1200 }} 1200w, {{ image | image_url: width: 2000 }} 2000w"
    sizes="{{ sizes_val }}"
    width="{{ img_w }}"
    height="{{ img_h }}"
    alt="{{ alt_text | escape }}"
    {% if css_class != blank %}class="{{ css_class }}"{% endif %}
    {% if img_loading != blank %}loading="{{ img_loading }}"{% endif %}
    {% if fetchpriority != blank %}fetchpriority="{{ fetchpriority }}"{% endif %}
    {% if style != blank %}style="{{ style }}"{% endif %}
    {% if panel != blank %}data-panel-img="{{ panel }}"{% endif %}
  >
{%- else -%}
  <img
    src="{{ file | prepend: 'sgym-v2-' | asset_url }}"
    width="{{ img_w }}"
    height="{{ img_h }}"
    alt="{{ alt_text | escape }}"
    {% if css_class != blank %}class="{{ css_class }}"{% endif %}
    {% if img_loading != blank %}loading="{{ img_loading }}"{% endif %}
    {% if fetchpriority != blank %}fetchpriority="{{ fetchpriority }}"{% endif %}
    {% if style != blank %}style="{{ style }}"{% endif %}
    {% if panel != blank %}data-panel-img="{{ panel }}"{% endif %}
  >
{%- endif -%}
