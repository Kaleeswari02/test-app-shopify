{{ 'sgym.css' | asset_url | stylesheet_tag }}
{% render 'sgym-fonts' %}
<script src="{{ 'sgym-ui.js' | asset_url }}" defer="defer"></script>

<div class="sgym sgym-section">
  <div class="sgym-wrap">
    <sgym-tabs class="sgym-tabs-card">
      <div class="sgym-tabs__media">
        {%- for block in section.blocks -%}
          <div class="sgym-tabs__panel{% if forloop.first %} is-active{% endif %}" data-sgym-tab-panel>
            {% render 'sgym-picture',
              image: block.settings.image,
              fallback: block.settings.fallback_asset,
              alt: block.settings.title,
              width: 1012,
              height: 1800,
              sizes: '(min-width: 990px) 320px, 70vw'
            %}
          </div>
        {%- endfor -%}
      </div>
      <div class="sgym-tabs__copy">
        {%- if section.settings.heading != blank -%}
          <h2 class="sgym-title" style="margin-bottom: 22px;">{{ section.settings.heading }}</h2>
        {%- endif -%}
        <div role="tablist" aria-label="{{ section.settings.heading | escape }}">
          {%- for block in section.blocks -%}
            <div class="sgym-tab{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
              <button
                type="button"
                class="sgym-tab__button"
                role="tab"
                id="SgymTab-{{ block.id }}"
                data-sgym-tab
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="SgymTabPanel-{{ block.id }}"
                {% unless forloop.first %}tabindex="-1"{% endunless %}
              >
                {{ block.settings.title }}
              </button>
              <div class="sgym-tab__panel rte" role="tabpanel" id="SgymTabPanel-{{ block.id }}" aria-labelledby="SgymTab-{{ block.id }}">
                {{ block.settings.text }}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </sgym-tabs>
  </div>
</div>

{% schema %}
{
  "name": "sGym tabs with image",
  "tag": "section",
  "class": "sgym-tabs-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Endless possibilities for your strength training" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "archivo_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "inter_n4" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Workouts" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe this tab.</p>" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Bundled image filename" }
      ]
    }
  ],
  "presets": [{ "name": "sGym tabs with image", "category": "sGym" }]
}
{% endschema %}
