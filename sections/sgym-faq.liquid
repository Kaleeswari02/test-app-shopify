{{ 'sgym.css' | asset_url | stylesheet_tag }}
{% render 'sgym-fonts' %}

<div class="sgym sgym-section" id="{{ section.settings.anchor | default: 'sgym-faq' }}">
  <div class="sgym-wrap">
    {% render 'sgym-heading', title: section.settings.heading %}
    <div class="sgym-faq-card">
      {%- for block in section.blocks -%}
        <details {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="sgym-acc-summary">
            <span>{{ block.settings.question }}</span>
            {% render 'sgym-icon', name: 'faq-plus-circle', size: 24, class: 'sgym-icon--closed' %}
            {% render 'sgym-icon', name: 'faq-minus-circle', size: 24, class: 'sgym-icon--open' %}
          </summary>
          <div class="sgym-faq__answer rte" id="SgymFaq-{{ block.id }}">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign faq_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank and block.settings.answer != blank -%}
            {%- if faq_index > 0 -%},{%- endif -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | strip_html | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | strip_html | json }}
              }
            }
            {%- assign faq_index = faq_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "sGym FAQ",
  "tag": "section",
  "class": "sgym-faq-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQ's" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "sgym-faq" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "archivo_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "inter_n4" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Top padding", "default": 28 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is included?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Add the answer.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "sGym FAQ", "category": "sGym" }]
}
{% endschema %}
