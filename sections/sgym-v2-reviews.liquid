{% render 'sgym-v2-assets' %}
{%- liquid
  assign avg = section.settings.average
  assign count = section.settings.count
  if product.metafields.reviews.rating.value.rating != blank
    assign avg = product.metafields.reviews.rating.value.rating | replace: '.', ','
  endif
  if product.metafields.reviews.rating_count != blank
    assign count = product.metafields.reviews.rating_count
  endif
-%}
<div class="sgym-v2">
  <section class="rv" id="bewertungen" data-node="227:1176" data-node-mobile="228:360" aria-labelledby="rv-title" data-reviews>
    <p class="rv__note">{{ section.settings.note }}</p>
    <h2 class="rv__title reveal" id="rv-title">{{ section.settings.heading }}</h2>
    <div class="rv__summary">
      <div class="rv__score">
        <p class="rv__avg">{{ avg }}</p>
        <div class="rv__count">
          <img class="fi-d" src="{{ 'sgym-v2-fb892.svg' | asset_url }}" width="150" height="30" alt="{{ avg }} von 5 Sternen">
          <img class="fi-m" src="{{ 'sgym-v2-f55f8.svg' | asset_url }}" width="100" height="20" alt="">
          <p>{{ count }} {{ section.settings.count_suffix }}</p>
        </div>
      </div>
      <ul class="rv__bars" aria-label="Verteilung der Bewertungen">
        {%- for block in section.blocks -%}
          {%- if block.type == 'bar' -%}
            <li class="rv__bar" {{ block.shopify_attributes }}>
              <span class="rv__bar-n">{{ block.settings.stars }}</span>
              <img class="rv__bar-img fi-d" src="{{ block.settings.file_d | prepend: 'sgym-v2-' | asset_url }}" width="{{ block.settings.width_d }}" height="20" alt="" style="{{ block.settings.margin }}">
              <img class="rv__bar-img fi-m" src="{{ block.settings.file_m | prepend: 'sgym-v2-' | asset_url }}" width="287" height="20" alt="">
              <span class="rv__bar-p">{{ block.settings.percent }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <div class="rv__media only-d">
      <div class="rv__block rv__block--videos" data-carousel="rv-videos">
        <h3 class="rv__btitle">{{ section.settings.videos_title }}</h3>
        <button class="rv__all" type="button" data-expand aria-expanded="false">{{ section.settings.see_all }}</button>
        <button class="rv__next" type="button" data-carousel-next aria-label="Weitere Videos"><img src="{{ 'sgym-v2-8df50.svg' | asset_url }}" width="28" height="28" alt=""></button>
        <div class="rv__vp" data-carousel-viewport>
          <ul class="rv__row">
            {%- for block in section.blocks -%}
              {%- if block.type == 'clip' and block.settings.place == 'videos' -%}
                <li {{ block.shopify_attributes }}><button class="rv__tile" type="button" data-vtile aria-pressed="false" aria-label="{{ block.settings.label | escape }}">
                  {% render 'sgym-v2-img', file: block.settings.file, image: block.settings.image, width: 151, height: 224, alt: '', img_class: 'rv__tile-img', loading: 'lazy', sizes: '151px' %}
                  <span class="rv__tile-fade" aria-hidden="true"></span>
                  <img class="rv__tile-play" src="{{ 'sgym-v2-b2a43.svg' | asset_url }}" width="34" height="34" alt=""><span class="rv__tile-pause" aria-hidden="true"></span>
                  <img class="rv__tile-stars" src="{{ 'sgym-v2-8931c.svg' | asset_url }}" width="92" height="16" alt="5 von 5 Sternen"><span class="rv__tile-progress" aria-hidden="true"></span>
                </button></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
      <div class="rv__block rv__block--photos" data-carousel="rv-photos">
        <h3 class="rv__btitle">{{ section.settings.photos_title }}</h3>
        <button class="rv__all" type="button" data-expand aria-expanded="false">{{ section.settings.see_all }}</button>
        <button class="rv__next" type="button" data-carousel-next aria-label="Weitere Fotos"><img src="{{ 'sgym-v2-2f75e.svg' | asset_url }}" width="28" height="28" alt=""></button>
        <div class="rv__vp" data-carousel-viewport>
          <ul class="rv__row">
            {%- for block in section.blocks -%}
              {%- if block.type == 'clip' and block.settings.place == 'photos' -%}
                <li class="rv__photo" {{ block.shopify_attributes }}>{% render 'sgym-v2-img', file: block.settings.file, image: block.settings.image, width: 137, height: 137, alt: block.settings.label, loading: 'lazy', sizes: '137px' %}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>

    <div class="rv__mmedia only-m">
      <div class="rv__mblock">
        <h3 class="rv__btitle">{{ section.settings.photos_title }}</h3>
        <button class="rv__mchev" type="button" data-expand aria-expanded="false" aria-label="Alle Fotos ansehen"><img src="{{ 'sgym-v2-f33c4.svg' | asset_url }}" width="24" height="24" alt=""></button>
        <ul class="rv__mrow">
          {%- for block in section.blocks -%}
            {%- if block.type == 'clip' and block.settings.place == 'mphotos' -%}
              <li class="rv__mthumb{% if block.settings.extra %} rv__extra{% endif %}" {{ block.shopify_attributes }}>{% render 'sgym-v2-img', file: block.settings.file, image: block.settings.image, width: 60, height: 60, alt: block.settings.label, loading: 'lazy', sizes: '60px' %}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      <div class="rv__mblock">
        <h3 class="rv__btitle">{{ section.settings.videos_title }}</h3>
        <button class="rv__mchev" type="button" data-expand aria-expanded="false" aria-label="Alle Videos ansehen"><img src="{{ 'sgym-v2-f33c4.svg' | asset_url }}" width="24" height="24" alt=""></button>
        <ul class="rv__mrow">
          {%- for block in section.blocks -%}
            {%- if block.type == 'clip' and block.settings.place == 'mvideos' -%}
              <li class="rv__mthumb{% if block.settings.extra %} rv__extra{% endif %}" {{ block.shopify_attributes }}>{% render 'sgym-v2-img', file: block.settings.file, image: block.settings.image, width: 60, height: 60, alt: block.settings.label, loading: 'lazy', sizes: '60px' %}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
    <img class="rv__line fi-m" src="{{ 'sgym-v2-dfb6a.svg' | asset_url }}" width="343" height="1" alt="">

    <div class="rv__tools">
      <div class="rv__filters">
        <div class="rv__rating">
          <button class="rv__select" type="button" data-rating-btn aria-haspopup="listbox" aria-expanded="false"><span data-rating-label>{{ section.settings.rating_label }}</span><img src="{{ 'sgym-v2-4a794.svg' | asset_url }}" width="17" height="17" alt=""></button>
          <ul class="rv__menu" role="listbox" aria-label="Nach Sternen filtern" hidden>
            <li role="option" aria-selected="false" data-rating="all">Alle Sterne</li>
            <li role="option" aria-selected="true" data-rating="5">5 Sterne</li>
            <li role="option" aria-selected="false" data-rating="4">4 Sterne</li>
            <li role="option" aria-selected="false" data-rating="3">3 Sterne</li>
            <li role="option" aria-selected="false" data-rating="2">2 Sterne</li>
            <li role="option" aria-selected="false" data-rating="1">1 Stern</li>
          </ul>
        </div>
        <div class="rv__chips" role="group" aria-label="Bewertungen sortieren und filtern">
          <button class="rv__chip" type="button" data-sort="new" aria-pressed="true">Neueste</button>
          <button class="rv__chip" type="button" data-sort="old" aria-pressed="false">Älteste</button>
          <button class="rv__chip" type="button" data-filter="photos" aria-pressed="false"><span class="only-d">Mit Fotos &amp; Videos</span><span class="only-m">Mit Fotos</span></button>
          <button class="rv__chip" type="button" data-filter="verified" aria-pressed="false"><span class="only-d">Verifizierter Kauf</span><span class="only-m">Verifiziert</span></button>
        </div>
      </div>
      <button class="rv__write" type="button">{{ section.settings.write_label }}</button>
    </div>

    <ul class="rv__list only-d" data-rv-list>
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' and block.settings.viewport != 'mobile' -%}
          <li class="rv__card rv__card--{% if block.settings.has_photos %}photos{% else %}text{% endif %}" data-date="{{ block.settings.date_iso }}" data-stars="{{ block.settings.stars }}" data-verified="{% if block.settings.verified %}true{% else %}false{% endif %}" data-photos="{% if block.settings.has_photos %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
            <article>
              <p class="rv__date">{{ block.settings.date_label }}</p>
              <p class="rv__name">{{ block.settings.name }}</p>
              {%- if block.settings.verified -%}<p class="rv__verified"><img src="{{ 'sgym-v2-04899.svg' | asset_url }}" width="18" height="18" alt="">Verifizierter Kauf</p>{%- endif -%}
              <img class="rv__stars" src="{{ 'sgym-v2-894d8.svg' | asset_url }}" width="80" height="16" alt="{{ block.settings.stars }} von 5 Sternen">
              <p class="rv__text">{{ block.settings.text }}</p>
              {%- if block.settings.has_photos -%}
                <ul class="rv__cphotos">
                  {%- if block.settings.photo_1 != blank -%}<li>{% render 'sgym-v2-img', file: block.settings.photo_1, image: block.settings.photo_1_image, width: 90, height: 90, alt: 'Kundenfoto', loading: 'lazy', sizes: '90px' %}</li>{%- endif -%}
                  {%- if block.settings.photo_2 != blank -%}<li>{% render 'sgym-v2-img', file: block.settings.photo_2, image: block.settings.photo_2_image, width: 90, height: 90, alt: 'Kundenfoto', loading: 'lazy', sizes: '90px' %}</li>{%- endif -%}
                  {%- if block.settings.photo_3 != blank -%}<li>{% render 'sgym-v2-img', file: block.settings.photo_3, image: block.settings.photo_3_image, width: 90, height: 90, alt: 'Kundenfoto', loading: 'lazy', sizes: '90px' %}</li>{%- endif -%}
                </ul>
              {%- endif -%}
              <div class="rv__helpful"><p>War diese Bewertung hilfreich?</p><span class="rv__thumbs"><button type="button" class="rv__thumb" data-helpful="up" aria-pressed="false" aria-label="Ja, hilfreich"><img src="{{ 'sgym-v2-d1eaf.svg' | asset_url }}" width="20" height="20" alt=""></button><button type="button" class="rv__thumb" data-helpful="down" aria-pressed="false" aria-label="Nein, nicht hilfreich"><img src="{{ 'sgym-v2-f4cce.svg' | asset_url }}" width="20" height="20" alt=""></button></span></div>
            </article>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    <ul class="rv__list only-m" data-rv-list>
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' and block.settings.viewport != 'desktop' -%}
          <li class="rv__card rv__card--{% if block.settings.has_photos %}photos{% else %}text{% endif %}" data-date="{{ block.settings.date_iso }}" data-stars="{{ block.settings.stars }}" data-verified="{% if block.settings.verified %}true{% else %}false{% endif %}" data-photos="{% if block.settings.has_photos %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
            <article>
              <p class="rv__date">{{ block.settings.date_label }}</p>
              <p class="rv__name">{{ block.settings.name }}</p>
              {%- if block.settings.verified -%}<p class="rv__verified"><img src="{{ 'sgym-v2-04899.svg' | asset_url }}" width="18" height="18" alt="">Verifizierter Kauf</p>{%- endif -%}
              <img class="rv__stars" src="{{ 'sgym-v2-894d8.svg' | asset_url }}" width="80" height="16" alt="{{ block.settings.stars }} von 5 Sternen">
              <p class="rv__text">{{ block.settings.text }}</p>
              {%- if block.settings.has_photos -%}
                <ul class="rv__cphotos">
                  {%- if block.settings.photo_1 != blank -%}<li>{% render 'sgym-v2-img', file: block.settings.photo_1, image: block.settings.photo_1_image, width: 90, height: 90, alt: 'Kundenfoto', loading: 'lazy', sizes: '90px' %}</li>{%- endif -%}
                  {%- if block.settings.photo_2 != blank -%}<li>{% render 'sgym-v2-img', file: block.settings.photo_2, image: block.settings.photo_2_image, width: 90, height: 90, alt: 'Kundenfoto', loading: 'lazy', sizes: '90px' %}</li>{%- endif -%}
                  {%- if block.settings.photo_3 != blank -%}<li>{% render 'sgym-v2-img', file: block.settings.photo_3, image: block.settings.photo_3_image, width: 90, height: 90, alt: 'Kundenfoto', loading: 'lazy', sizes: '90px' %}</li>{%- endif -%}
                </ul>
              {%- endif -%}
              <div class="rv__helpful"><p>War diese Bewertung hilfreich?</p><span class="rv__thumbs"><button type="button" class="rv__thumb" data-helpful="up" aria-pressed="false" aria-label="Ja, hilfreich"><img src="{{ 'sgym-v2-d1eaf.svg' | asset_url }}" width="20" height="20" alt=""></button><button type="button" class="rv__thumb" data-helpful="down" aria-pressed="false" aria-label="Nein, nicht hilfreich"><img src="{{ 'sgym-v2-f4cce.svg' | asset_url }}" width="20" height="20" alt=""></button></span></div>
            </article>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    <p class="rv__empty" data-rv-empty hidden>{{ section.settings.empty }}</p>
  </section>
</div>
{% schema %}
{
  "name": "sGym v2 Bewertungen",
  "tag": "div",
  "class": "sgym-v2-host",
  "disabled_on": { "groups": ["header", "footer"] },
  "enabled_on": { "templates": ["product"] },
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "note", "label": "Hinweis", "default": "PLATZHALTER · BEISPIEL-BEWERTUNGEN" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Kundenrezensionen" },
    { "type": "text", "id": "average", "label": "Durchschnitt", "default": "4,8" },
    { "type": "text", "id": "count", "label": "Anzahl", "default": "249" },
    { "type": "text", "id": "count_suffix", "label": "Anzahl Zusatz", "default": "Bewertungen" },
    { "type": "text", "id": "videos_title", "label": "Video-Titel", "default": "Bewertungen mit Videos" },
    { "type": "text", "id": "photos_title", "label": "Foto-Titel", "default": "Bewertungen mit Fotos" },
    { "type": "text", "id": "see_all", "label": "Alle ansehen", "default": "Alle ansehen" },
    { "type": "text", "id": "rating_label", "label": "Sterne-Filter", "default": "Bewertung: 5 Sterne" },
    { "type": "text", "id": "write_label", "label": "Schreiben-Button", "default": "Rezension schreiben" },
