{{ 'sgym.css' | asset_url | stylesheet_tag }}
{% render 'sgym-fonts' %}
<script src="{{ 'sgym-ui.js' | asset_url }}" defer="defer"></script>

<div class="sgym sgym-section sgym-video-feature">
  <div class="sgym-wrap">
    {%- if section.settings.show_stars -%}
      <div class="sgym-video-feature__stars">
        {% render 'sgym-stars', rating: 4.5, scale: 5, size: 24 %}
      </div>
    {%- endif -%}
    {% render 'sgym-heading', eyebrow: section.settings.eyebrow, title: section.settings.heading %}
    <sgym-inline-video class="sgym-video-stage" data-autoplay="{% if section.settings.autoplay %}true{% else %}false{% endif %}">
      {% render 'sgym-video',
        video: section.settings.video,
        video_url: section.settings.video_url,
        image: section.settings.image,
        fallback: section.settings.fallback_asset,
        alt: section.settings.heading,
        autoplay: section.settings.autoplay,
        loop: true,
        muted: true,
        controls: false,
        width: 1800,
        height: 1021,
        sizes: '(min-width: 990px) 1246px, 100vw'
      %}
      <button type="button" class="sgym-video-stage__btn sgym-video-stage__btn--mute" data-sgym-mute aria-pressed="true" aria-label="{{ section.settings.mute_label }}">
        <img class="is-muted" src="{{ 'sgym-volume-off.svg' | asset_url }}" width="24" height="24" alt="">
        <img class="is-unmuted" src="{{ 'sgym-volume-on.svg' | asset_url }}" width="24" height="24" alt="">
      </button>
      <button type="button" class="sgym-video-stage__btn sgym-video-stage__btn--pause" data-sgym-pause aria-pressed="true" aria-label="{{ section.settings.pause_label }}">
        <img class="is-pause" src="{{ 'sgym-play-button.svg' | asset_url }}" width="44" height="44" alt="">
        <img class="is-play" src="{{ 'sgym-play-button-play.svg' | asset_url }}" width="44" height="44" alt="">
      </button>
    </sgym-inline-video>
  </div>
</div>

{% schema %}
{
  "name": "sGym video feature",
  "tag": "section",
  "class": "sgym-video-feature-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "checkbox", "id": "show_stars", "label": "Show stars", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "No Excuses with #SaschaHuber!" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recommended by one of the biggest home fitness influencers in the German-speaking world." },
    { "type": "image_picker", "id": "image", "label": "Poster" },
    { "type": "text", "id": "fallback_asset", "label": "Bundled poster filename", "default": "sgym-influencer-sascha-huber-video-poster.jpg" },
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "video_url", "id": "video_url", "label": "Video URL", "accept": ["youtube", "vimeo"] },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay muted", "default": true, "info": "Skipped when the visitor prefers reduced motion. No video file was included in the design export, so the poster shows until a video is selected." },
    { "type": "text", "id": "pause_label", "label": "Pause label", "default": "Pause video" },
    { "type": "text", "id": "mute_label", "label": "Mute label", "default": "Mute video" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "archivo_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "inter_n4" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "presets": [{ "name": "sGym video feature", "category": "sGym" }]
}
{% endschema %}
