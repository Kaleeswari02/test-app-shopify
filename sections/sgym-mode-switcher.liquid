{{ 'sgym.css' | asset_url | stylesheet_tag }}
{% render 'sgym-fonts' %}
<script src="{{ 'sgym-ui.js' | asset_url }}" defer="defer"></script>

<div class="sgym sgym-section">
  <div class="sgym-wrap">
    <div class="sgym-modes">
      {% render 'sgym-heading', title: section.settings.heading, text: section.settings.subheading, title_class: 'sgym-title--loose' %}
      <sgym-modes>
        <div class="sgym-modes__stage">
          {%- for block in section.blocks -%}
            <div class="sgym-modes__panel{% if forloop.first %} is-active{% endif %}" data-sgym-mode-panel {{ block.shopify_attributes }}>
              {%- assign mode_alt = block.settings.title | default: block.settings.label -%}
              {% render 'sgym-picture',
                image: block.settings.image,
                fallback: block.settings.fallback_asset,
                alt: mode_alt,
                width: 1800,
                height: 1184,
                sizes: '(min-width: 990px) 1080px, 100vw'
              %}
              {%- if block.settings.title != blank or block.settings.text != blank -%}
                <div class="sgym-modes__overlay">
                  {%- if block.settings.icon != blank -%}
                    {{
                      block.settings.icon
                      | image_url: width: 116
                      | image_tag: class: 'sgym-modes__icon', widths: '58, 116', sizes: '58px', alt: '', loading: 'lazy'
                    }}
                  {%- else -%}
                    {% render 'sgym-icon', name: 'icon-partner-exchange', size: 58, class: 'sgym-modes__icon' %}
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <h3>{{ block.settings.title | newline_to_br }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p>{{ block.settings.text }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
          <div class="sgym-modes__switch" role="tablist" aria-label="{{ section.settings.heading | escape }}">
            <span class="sgym-modes__thumb" aria-hidden="true"></span>
            {%- for block in section.blocks -%}
              <button
                type="button"
                role="tab"
                data-sgym-mode
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                {{ block.settings.label }}
              </button>
            {%- endfor -%}
          </div>
        </div>
      </sgym-modes>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "sGym mode switcher",
  "tag": "section",
  "class": "sgym-mode-switcher-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dynamic training modes" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Whether you train solo or with a partner – you'll always find the right setup for your goals.</p>" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "archivo_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "inter_n4" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "Top padding", "default": 25 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "Bottom padding", "default": 25 }
  ],
  "blocks": [
    {
      "type": "mode",
      "name": "Mode",
      "settings": [
        { "type": "text", "id": "label", "label": "Switch label", "default": "Partnermodus:" },
        { "type": "text", "id": "title", "label": "Overlay title", "default": "PARTNER MODUS:" },
        { "type": "textarea", "id": "text", "label": "Overlay text", "default": "Train as a duo, double your progress." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "icon", "label": "Overlay icon", "info": "58px mark. Leave empty to use the bundled partner-exchange icon on every mode." },
        { "type": "text", "id": "fallback_asset", "label": "Bundled image filename" }
      ]
    }
  ],
  "presets": [{ "name": "sGym mode switcher", "category": "sGym" }]
}
{% endschema %}
