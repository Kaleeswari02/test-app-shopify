{{ 'sgym.css' | asset_url | stylesheet_tag }}
{% render 'sgym-fonts' %}
<script src="{{ 'sgym-ui.js' | asset_url }}" defer="defer"></script>

<div class="sgym sgym-section">
  <div class="sgym-wrap">
    <div class="sgym-modes">
      {% render 'sgym-heading', title: section.settings.heading, text: section.settings.subheading %}
      <sgym-modes>
        <div class="sgym-modes__stage">
          {%- for block in section.blocks -%}
            <div class="sgym-modes__panel{% if forloop.first %} is-active{% endif %}" data-sgym-mode-panel {{ block.shopify_attributes }}>
              {% render 'sgym-picture',
                image: block.settings.image,
                fallback: block.settings.fallback_asset,
                alt: block.settings.title | default: block.settings.label,
                width: 1800,
                height: 900,
                sizes: '(min-width: 990px) 1100px, 100vw'
              %}
              {%- if block.settings.title != blank or block.settings.text != blank -%}
                <div class="sgym-modes__overlay">
                  {%- if block.settings.title != blank -%}
                    <h3>{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p>{{ block.settings.text }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        <div class="sgym-modes__switch" role="tablist" aria-label="{{ section.settings.heading | escape }}">
          {%- for block in section.blocks -%}
            <button
              type="button"
              role="tab"
              data-sgym-mode
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              {{ block.settings.label }}
            </button>
          {%- endfor -%}
        </div>
      </sgym-modes>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "sGym mode switcher",
  "tag": "section",
  "class": "sgym-mode-switcher-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dynamic training modes" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Whether you train solo or with a partner – you'll always find the right setup for your goals.</p>" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "archivo_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "inter_n4" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Top padding", "default": 20 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Bottom padding", "default": 20 }
  ],
  "blocks": [
    {
      "type": "mode",
      "name": "Mode",
      "settings": [
        { "type": "text", "id": "label", "label": "Switch label", "default": "Partnermodus:" },
        { "type": "text", "id": "title", "label": "Overlay title", "default": "PARTNER MODUS:" },
        { "type": "textarea", "id": "text", "label": "Overlay text", "default": "Train as a duo, double your progress." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Bundled image filename" }
      ]
    }
  ],
  "presets": [{ "name": "sGym mode switcher", "category": "sGym" }]
}
{% endschema %}
