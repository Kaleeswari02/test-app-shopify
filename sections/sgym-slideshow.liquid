{{ 'sgym.css' | asset_url | stylesheet_tag }}
{% render 'sgym-fonts' %}
<script src="{{ 'sgym-ui.js' | asset_url }}" defer="defer"></script>

<div class="sgym sgym-section">
  <div class="sgym-wrap">
    <div class="sgym-slide-card">
      <sgym-show
        class="sgym-show"
        data-autoplay="{% if section.settings.autoplay %}true{% else %}false{% endif %}"
        data-interval="{{ section.settings.interval | times: 1000 }}"
        data-counter-word="{{ section.settings.counter_label | escape }}"
        tabindex="0"
      >
        <div class="sgym-slide-card__top">
          <div>
            {%- if section.settings.heading != blank -%}
              <h2 class="sgym-title sgym-title--loose">{{ section.settings.heading }}</h2>
            {%- endif -%}
            {%- if section.settings.text != blank -%}
              <div class="sgym-sub rte">{{ section.settings.text }}</div>
            {%- endif -%}
          </div>
        </div>
        <p class="sgym-counter">
          <span class="sgym-counter__text" data-sgym-count>1 {{ section.settings.counter_label }} {{ section.blocks.size }}</span>
          <button
            type="button"
            class="sgym-counter__toggle"
            data-sgym-toggle
            aria-pressed="false"
            aria-label="Play slideshow"
          >
            <svg class="sgym-counter__ring" viewBox="0 0 55 55" width="55" height="55" aria-hidden="true">
              <circle cx="27.5" cy="27.5" r="25" fill="none" stroke="rgba(109,109,109,0.6)" stroke-width="2.5"></circle>
              <circle class="sgym-counter__arc" cx="27.5" cy="27.5" r="25" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" pathLength="100"></circle>
            </svg>
            <svg class="sgym-counter__glyph sgym-counter__glyph--pause" viewBox="0 0 12 12" aria-hidden="true">
              <rect x="2" y="1.5" width="2.4" height="9" rx="0.4" fill="#fff"></rect>
              <rect x="7.6" y="1.5" width="2.4" height="9" rx="0.4" fill="#fff"></rect>
            </svg>
            <svg class="sgym-counter__glyph sgym-counter__glyph--play" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M3.2 1.6v8.8L10.4 6 3.2 1.6z" fill="#fff"></path>
            </svg>
            <span class="sgym-counter__num" data-sgym-num>1</span>
          </button>
        </p>
        <div class="sgym-show__panel">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'collage' -%}
                <div class="sgym-slide sgym-slide--collage{% if forloop.first %} is-active{% endif %}" data-sgym-slide {{ block.shopify_attributes }}>
                  <div class="sgym-collage">
                    {%- assign collage_alt = section.settings.heading -%}
                    {% render 'sgym-picture',
                      image: block.settings.image,
                      fallback: block.settings.fallback_asset,
                      alt: collage_alt,
                      width: 2222,
                      height: 1400,
                      sizes: '(min-width: 990px) 1111px, 100vw',
                      class: 'sgym-collage__img'
                    %}
                  </div>
                  <span class="sgym-slide__label" style="--sgym-label-x: 25.2%; --sgym-label-y: 7.14%; --sgym-label-bottom: auto; --i: 0;">Trainingsdaten</span>
                  <span class="sgym-slide__label sgym-slide__label--live" style="--sgym-label-x: 70.12%; --sgym-label-y: 3.14%; --sgym-label-bottom: auto; --i: 1;">...und vieles mehr in der<br>Sportstech Live App</span>
                  <span class="sgym-slide__label" style="--sgym-label-x: 3.42%; --sgym-label-y: 22.71%; --sgym-label-bottom: auto; --i: 2;">Workouts</span>
                  <img
                    class="sgym-ai-badge"
                    src="{{ 'sgym-ai-badge-50.png' | asset_url }}"
                    alt=""
                    width="50"
                    height="50"
                  >
                  <span class="sgym-slide__label" style="--sgym-label-x: 86.41%; --sgym-label-y: 19.57%; --sgym-label-bottom: auto; --i: 3;">Stats</span>
                  <span class="sgym-slide__label" style="--sgym-label-x: 2.61%; --sgym-label-y: 84.86%; --sgym-label-bottom: auto; --i: 4;">Landscapes</span>
                  <span class="sgym-slide__label" style="--sgym-label-x: 85.69%; --sgym-label-y: 82%; --sgym-label-bottom: auto; --i: 5;">Recipes</span>
                  {%- if section.settings.link_label != blank -%}
                    <a class="sgym-slide-card__link" href="{{ section.settings.link | default: 'https://www.sportstech.de/live-app' }}">{{ section.settings.link_label }}</a>
                  {%- endif -%}
                </div>
              {%- when 'video' -%}
                <div class="sgym-slide sgym-slide--video{% if forloop.first %} is-active{% endif %}" data-sgym-slide {{ block.shopify_attributes }}>
                  {%- assign poster_alt = block.settings.label | default: section.settings.heading -%}
                  {%- capture poster_src -%}
                    {%- if block.settings.poster != blank -%}
                      {{ block.settings.poster | image_url: width: 1600 }}
                    {%- elsif block.settings.fallback_asset != blank -%}
                      {{ block.settings.fallback_asset | asset_url }}
                    {%- endif -%}
                  {%- endcapture -%}
                  <video
                    class="sgym-slide__video"
                    muted
                    playsinline
                    preload="metadata"
                    {% if poster_src != blank %}
                      poster="{{ poster_src | strip }}"
                    {% endif %}
                    data-sgym-video
                  >
                    {%- if block.settings.video != blank -%}
                      {%- for source in block.settings.video.sources -%}
                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                      {%- endfor -%}
                    {%- elsif block.settings.video_asset != blank -%}
                      <source src="{{ block.settings.video_asset | asset_url }}" type="video/mp4">
                    {%- endif -%}
                  </video>
                  {%- if block.settings.label != blank -%}
                    <span class="sgym-slide__label" style="--sgym-label-x: {{ block.settings.label_x }}%; --sgym-label-y: {{ block.settings.label_y }}%; --sgym-label-bottom: auto;">{{ block.settings.label }}</span>
                  {%- endif -%}
                </div>
              {%- else -%}
                <div class="sgym-slide{% if forloop.first %} is-active{% endif %}" data-sgym-slide {{ block.shopify_attributes }}>
                  {%- assign slide_alt = block.settings.label | default: section.settings.heading -%}
                  {% render 'sgym-picture',
                    image: block.settings.image,
                    fallback: block.settings.fallback_asset,
                    alt: slide_alt,
                    width: 1600,
                    height: 900,
                    sizes: '(min-width: 990px) 1100px, 100vw',
                    class: 'sgym-slide__poster'
                  %}
                  {%- if block.settings.label != blank -%}
                    <span class="sgym-slide__label" style="--sgym-label-x: {{ block.settings.label_x }}%; --sgym-label-y: {{ block.settings.label_y }}%; --sgym-label-bottom: auto;">{{ block.settings.label }}</span>
                  {%- endif -%}
                  {%- if block.settings.label_2 != blank -%}
                    <span class="sgym-slide__label" style="--sgym-label-x: {{ block.settings.label_2_x }}%; --sgym-label-y: {{ block.settings.label_2_y }}%; --sgym-label-bottom: auto;">{{ block.settings.label_2 }}</span>
                  {%- endif -%}
                  {%- if block.settings.label_3 != blank -%}
                    <span class="sgym-slide__label" style="--sgym-label-x: {{ block.settings.label_3_x }}%; --sgym-label-y: {{ block.settings.label_3_y }}%; --sgym-label-bottom: auto;">{{ block.settings.label_3 }}</span>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </sgym-show>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "sGym slideshow",
  "tag": "section",
  "class": "sgym-slideshow-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "More than just your smart gym." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Mit dem sGym Pro erhältst du Zugang zu einem smarten, digitalen Ökosystem, das Training, Daten und Coaching nahtlos verbindet.</p>" },
    { "type": "text", "id": "counter_label", "label": "Counter word", "default": "OF" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "https://www.sportstech.de/live-app" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true, "info": "Starts when half the section is in view. Off when the visitor prefers reduced motion." },
    { "type": "range", "id": "interval", "min": 3, "max": 12, "step": 1, "unit": "s", "label": "Slide duration", "default": 6, "info": "Image and collage slides use this. A video slide uses its own length, up to 12 seconds." },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "archivo_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "inter_n4" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "Top padding", "default": 25 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "Bottom padding", "default": 25 }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video slide",
      "settings": [
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "text", "id": "video_asset", "label": "Bundled video filename", "info": "Used when the video picker is empty. MP4 in the theme assets." },
        { "type": "image_picker", "id": "poster", "label": "Poster" },
        { "type": "text", "id": "fallback_asset", "label": "Bundled poster filename" },
        { "type": "text", "id": "label", "label": "Label", "default": "Stats" },
        { "type": "range", "id": "label_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Label horizontal", "default": 86 },
        { "type": "range", "id": "label_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Label vertical", "default": 20 }
      ]
    },
    {
      "type": "collage",
      "name": "App collage",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Collage image" },
        { "type": "text", "id": "fallback_asset", "label": "Bundled collage filename", "default": "sgym-app-collage-3of3.png" }
      ]
    },
    {
      "type": "slide",
      "name": "Image slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Bundled image filename" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "range", "id": "label_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Label horizontal", "default": 8 },
        { "type": "range", "id": "label_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Label vertical", "default": 72 },
        { "type": "text", "id": "label_2", "label": "Second label" },
        { "type": "range", "id": "label_2_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Second label horizontal", "default": 40 },
        { "type": "range", "id": "label_2_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Second label vertical", "default": 18 },
        { "type": "text", "id": "label_3", "label": "Third label" },
        { "type": "range", "id": "label_3_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Third label horizontal", "default": 62 },
        { "type": "range", "id": "label_3_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Third label vertical", "default": 46 }
      ]
    }
  ],
  "presets": [
    {
      "name": "sGym slideshow",
      "category": "sGym",
      "blocks": [
        { "type": "video" },
        { "type": "collage" }
      ]
    }
  ]
}
{% endschema %}
