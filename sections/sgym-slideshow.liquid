{{ 'sgym.css' | asset_url | stylesheet_tag }}
{% render 'sgym-fonts' %}
<script src="{{ 'sgym-carousel.js' | asset_url }}" defer="defer"></script>

<div class="sgym sgym-section">
  <div class="sgym-wrap">
    <div class="sgym-slide-card">
      <sgym-carousel
        data-autoplay="{% if section.settings.autoplay %}true{% else %}false{% endif %}"
        data-interval="{{ section.settings.interval | times: 1000 }}"
        data-loop="true"
      >
        <div class="sgym-slide-card__top">
          <div>
            {%- if section.settings.heading != blank -%}
              <h2 class="sgym-title sgym-title--loose">{{ section.settings.heading }}</h2>
            {%- endif -%}
            {%- if section.settings.text != blank -%}
              <div class="sgym-sub rte">{{ section.settings.text }}</div>
            {%- endif -%}
          </div>
        </div>
        <p class="sgym-counter">
          <span class="sgym-counter__badge">
            <svg class="sgym-counter__ring" viewBox="0 0 55 55" width="55" height="55" aria-hidden="true">
              <circle cx="27.5" cy="27.5" r="25" fill="none" stroke="rgba(255,255,255,.28)" stroke-width="1.5"></circle>
              <circle class="sgym-counter__arc" cx="27.5" cy="27.5" r="25" fill="none" stroke="#fff" stroke-width="1.5" pathLength="100"></circle>
            </svg>
            <span data-sgym-current>1</span>
          </span>
          <span>{{ section.settings.counter_label }} <span data-sgym-total>{{ section.blocks.size }}</span></span>
        </p>
        <div class="sgym-viewport" data-sgym-viewport tabindex="0">
          <ul class="sgym-track" data-sgym-track>
            {%- for block in section.blocks -%}
              <li class="sgym-slide" style="flex-basis: 100%;" {{ block.shopify_attributes }}>
                {%- assign slide_alt = block.settings.label | default: section.settings.heading -%}
                {% render 'sgym-picture',
                  image: block.settings.image,
                  fallback: block.settings.fallback_asset,
                  alt: slide_alt,
                  width: 1600,
                  height: 900,
                  sizes: '(min-width: 990px) 1100px, 100vw'
                %}
                {%- if block.settings.label != blank -%}
                  <span class="sgym-slide__label" style="--sgym-label-x: {{ block.settings.label_x }}%; --sgym-label-y: {{ block.settings.label_y }}%; --sgym-label-bottom: auto;">{{ block.settings.label }}</span>
                {%- endif -%}
                {%- if block.settings.label_2 != blank -%}
                  <span class="sgym-slide__label" style="--sgym-label-x: {{ block.settings.label_2_x }}%; --sgym-label-y: {{ block.settings.label_2_y }}%; --sgym-label-bottom: auto;">{{ block.settings.label_2 }}</span>
                {%- endif -%}
                {%- if block.settings.label_3 != blank -%}
                  <span class="sgym-slide__label" style="--sgym-label-x: {{ block.settings.label_3_x }}%; --sgym-label-y: {{ block.settings.label_3_y }}%; --sgym-label-bottom: auto;">{{ block.settings.label_3 }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
        <div class="sgym-dots" data-sgym-dots></div>
      </sgym-carousel>
      {%- if section.settings.link_label != blank -%}
        <a class="sgym-slide-card__link" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "sGym slideshow",
  "tag": "section",
  "class": "sgym-slideshow-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "More than just your smart gym." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Mit dem sGym Pro erhältst du Zugang zu einem smarten, digitalen Ökosystem, das Training, Daten und Coaching nahtlos verbindet.</p>" },
    { "type": "text", "id": "counter_label", "label": "Counter word", "default": "OF" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "https://www.sportstech.de/live-app" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true, "info": "Autoplay is disabled when the visitor prefers reduced motion." },
    { "type": "range", "id": "interval", "min": 3, "max": 10, "step": 1, "unit": "s", "label": "Autoplay interval", "default": 5 },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "archivo_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "inter_n4" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "Top padding", "default": 25 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "Bottom padding", "default": 25 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Bundled image filename" },
        { "type": "text", "id": "label", "label": "Label", "default": "Workouts" },
        { "type": "range", "id": "label_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Label horizontal", "default": 8 },
        { "type": "range", "id": "label_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Label vertical", "default": 72 },
        { "type": "text", "id": "label_2", "label": "Second label" },
        { "type": "range", "id": "label_2_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Second label horizontal", "default": 40 },
        { "type": "range", "id": "label_2_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Second label vertical", "default": 18 },
        { "type": "text", "id": "label_3", "label": "Third label" },
        { "type": "range", "id": "label_3_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Third label horizontal", "default": 62 },
        { "type": "range", "id": "label_3_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Third label vertical", "default": 46 }
      ]
    }
  ],
  "presets": [{ "name": "sGym slideshow", "category": "sGym" }]
}
{% endschema %}
