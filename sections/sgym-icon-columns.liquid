{{ 'sgym.css' | asset_url | stylesheet_tag }}
{% render 'sgym-fonts' %}

<div class="sgym sgym-section">
  <div class="sgym-wrap">
    {% render 'sgym-heading', title: section.settings.heading, text: section.settings.subheading %}
    <div class="sgym-icons">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            {% render 'sgym-icon', name: block.settings.icon, size: 44 %}
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3>{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "sGym icon columns",
  "tag": "section",
  "class": "sgym-icon-columns-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The shop you can trust" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "archivo_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "inter_n4" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "guarantee-calendar-clock",
          "options": [
            { "value": "guarantee-calendar-clock", "label": "Calendar" },
            { "value": "guarantee-delivery-truck", "label": "Delivery" },
            { "value": "guarantee-receipt", "label": "Receipt" },
            { "value": "trust-box", "label": "Box" },
            { "value": "trust-shield", "label": "Shield" },
            { "value": "trust-users", "label": "Customers" },
            { "value": "none", "label": "None" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "30-day trial" },
        { "type": "text", "id": "text", "label": "Text", "default": "Money-back guarantee." }
      ]
    }
  ],
  "presets": [{ "name": "sGym icon columns", "category": "sGym" }]
}
{% endschema %}
