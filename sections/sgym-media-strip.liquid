{{ 'sgym.css' | asset_url | stylesheet_tag }}
{% render 'sgym-fonts' %}
<script src="{{ 'sgym-carousel.js' | asset_url }}" defer="defer"></script>

<div class="sgym sgym-section sgym-strip">
  <div class="sgym-wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="sgym-strip__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <sgym-carousel class="sgym-carousel sgym-carousel--dots-mobile sgym-carousel--arrows-desktop" data-loop="true">
      <div class="sgym-viewport" data-sgym-viewport tabindex="0">
        <ul class="sgym-track" data-sgym-track>
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a class="sgym-strip__card" href="{{ block.settings.link }}">
              {%- else -%}
                <div class="sgym-strip__card">
              {%- endif -%}
              {%- assign strip_alt = block.settings.image.alt | default: section.settings.heading -%}
              {% render 'sgym-picture',
                image: block.settings.image,
                fallback: block.settings.fallback_asset,
                alt: strip_alt,
                width: 400,
                height: 500,
                sizes: '148px',
                class: 'sgym-strip__img'
              %}
              {%- if block.settings.link != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
      <div class="sgym-dots" data-sgym-dots></div>
    </sgym-carousel>
  </div>
</div>

{% schema %}
{
  "name": "sGym media strip",
  "tag": "section",
  "class": "sgym-media-strip-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recommended by #SashaHuber" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "archivo_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "inter_n4" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Top padding", "default": 28 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Bottom padding", "default": 28 }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "Thumbnail",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Bundled image filename" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "sGym media strip",
      "category": "sGym",
      "blocks": [
        { "type": "media" },
        { "type": "media" },
        { "type": "media" },
        { "type": "media" },
        { "type": "media" }
      ]
    }
  ]
}
{% endschema %}
