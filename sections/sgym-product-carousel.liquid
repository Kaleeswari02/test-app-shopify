{{ 'sgym.css' | asset_url | stylesheet_tag }}
{% render 'sgym-fonts' %}
<script src="{{ 'sgym-carousel.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign card_products = nil
  assign listed_products = section.settings.product_list | size
  if listed_products > 0
    assign card_products = section.settings.product_list
  elsif section.settings.collection != blank and section.settings.collection.products_count > 0
    assign card_products = section.settings.collection.products
  endif
-%}

<div class="sgym sgym-section sgym--dark">
  <div class="sgym-wrap">
    <sgym-carousel class="sgym-carousel sgym-carousel--dots-mobile">
      <div class="sgym-carousel__head">
        <div class="sgym-intro">
          {%- if section.settings.eyebrow != blank -%}
            <p class="sgym-pill-tag">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="sgym-title">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <div class="sgym-sub rte">{{ section.settings.subheading }}</div>
          {%- endif -%}
        </div>
        <div class="sgym-carousel__arrows">
          <button type="button" class="sgym-arrow" data-sgym-prev aria-label="{{ 'general.slider.previous_slide' | t }}">
            <img class="is-active" src="{{ 'sgym-carousel-next-light.svg' | asset_url }}" alt="" width="54" height="54">
            <img class="is-disabled" src="{{ 'sgym-carousel-prev-dark.svg' | asset_url }}" alt="" width="54" height="54">
          </button>
          <button type="button" class="sgym-arrow" data-sgym-next aria-label="{{ 'general.slider.next_slide' | t }}">
            <img class="is-active" src="{{ 'sgym-carousel-next-light.svg' | asset_url }}" alt="" width="54" height="54">
            <img class="is-disabled" src="{{ 'sgym-carousel-prev-dark.svg' | asset_url }}" alt="" width="54" height="54">
          </button>
        </div>
      </div>
      <div class="sgym-viewport" data-sgym-viewport tabindex="0">
        <ul class="sgym-track" data-sgym-track>
          {%- if card_products != nil -%}
            {%- for card_product in card_products limit: section.settings.products_to_show -%}
              <li>
                {% render 'sgym-accessory-card', card_product: card_product, section_id: section.id %}
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {% render 'sgym-accessory-card',
                  card_product: block.settings.product,
                  title: block.settings.title,
                  image: block.settings.image,
                  fallback: block.settings.fallback_asset,
                  link: block.settings.link,
                  section_id: section.id,
                  block_id: block.id
                %}
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
      <div class="sgym-dots" data-sgym-dots></div>
    </sgym-carousel>
  </div>
</div>

{% schema %}
{
  "name": "sGym product carousel",
  "tag": "section",
  "class": "sgym-product-carousel-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Equipment" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The right accessories for every workout" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Complete training setup for optimal results.</p>" },
    { "type": "product_list", "id": "product_list", "label": "Products", "limit": 12 },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 8, "info": "Manual cards are used when no products or collection is selected." },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "archivo_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "inter_n4" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Accessory",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "title", "label": "Title", "default": "Safety spotter" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Bundled image filename" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "sGym product carousel", "category": "sGym" }]
}
{% endschema %}
