{% render 'sgym-v2-assets' %}
<div class="sgym-v2">
  <section class="hero" id="hero" data-node="227:1161" data-node-mobile="228:345" aria-label="{{ section.settings.heading | escape }}">
    {%- if section.settings.video_url != blank -%}
      <video class="hero__bg" width="2400" height="1022" autoplay muted loop playsinline {% if section.settings.image != blank %}poster="{{ section.settings.image | image_url: width: 2000 }}"{% else %}poster="{{ section.settings.image_file | prepend: 'sgym-v2-' | asset_url }}"{% endif %}>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- else -%}
      {% render 'sgym-v2-img',
        file: section.settings.image_file,
        image: section.settings.image,
        width: 2400,
        height: 1022,
        alt: section.settings.image_alt,
        img_class: 'hero__bg',
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        widths: '750, 1100, 1500, 2000, 2400'
      %}
    {%- endif -%}
    <div class="hero__inner">
      <div class="hero__copy">
        <h1 class="hero__title">{{ section.settings.heading }}</h1>
        <p class="hero__sub">{{ section.settings.subheading }}</p>
      </div>
      <a class="hero__scroll" href="#produkt" aria-label="{{ section.settings.scroll_label | escape }}"><img src="{{ 'sgym-v2-68aae.svg' | asset_url }}" width="55" height="22" alt=""></a>
      <div class="hero__actions">
        <button class="pill-btn hero__video" type="button" data-video-open="hero">{{ section.settings.video_label }}</button>
        <button class="vctrl" type="button" data-vctrl aria-pressed="false" aria-label="Video pausieren"></button>
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "sGym v2 Hero",
  "tag": "div",
  "class": "sgym-v2-host",
  "disabled_on": { "groups": ["header", "footer"] },
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "sGym Pro" },
    { "type": "text", "id": "subheading", "label": "Unterzeile", "default": "Die nächste Generation des Krafttrainings" },
    { "type": "text", "id": "video_label", "label": "Video-Button", "default": "VIDEO ANSEHEN" },
    { "type": "text", "id": "scroll_label", "label": "Scroll-Button (Barrierefreiheit)", "default": "Zum Produkt scrollen" },
    { "type": "image_picker", "id": "image", "label": "Hintergrundbild" },
    { "type": "text", "id": "image_file", "label": "Fallback-Datei", "default": "91f1b.webp" },
    { "type": "text", "id": "image_alt", "label": "Bildbeschreibung", "default": "Mann trainiert Klimmzüge an der sGym Pro Kraftstation" },
    { "type": "url", "id": "video_url", "label": "Video-URL (optional, MP4)" }
  ],
  "presets": [{ "name": "sGym v2 Hero" }]
}
{% endschema %}
