{% render 'sgym-v2-assets' %}
<div class="sgym-v2">
  <section class="smart" id="smart-gym" data-node="227:1169" data-node-mobile="228:353" aria-labelledby="smart-title">
    <div class="smart__card">
      <div class="smart__head">
        <h2 class="smart__title reveal" id="smart-title">{{ section.settings.heading }}</h2>
        <p class="smart__sub">{{ section.settings.subheading }}</p>
      </div>
      {% render 'sgym-v2-smart-stage', link: section.settings.link %}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "sGym v2 Smart Gym",
  "tag": "div",
  "class": "sgym-v2-host",
  "disabled_on": { "groups": ["header", "footer"] },
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Mehr als nur dein Smart Gym." },
    { "type": "textarea", "id": "subheading", "label": "Text", "default": "Mit dem sGym Pro erhältst du Zugang zu einem smarten, digitalen Ökosystem, das Training, Daten und Coaching nahtlos verbindet." },
    { "type": "url", "id": "link", "label": "App-Link", "default": "https://www.sportstech.de/live-app" }
  ],
  "presets": [{ "name": "sGym v2 Smart Gym" }]
}
{% endschema %}
