{{ 'sgym.css' | asset_url | stylesheet_tag }}
{% render 'sgym-fonts' %}

<div class="sgym sgym-section">
  <div class="sgym-wrap">
    {% render 'sgym-heading', title: section.settings.heading, text: section.settings.subheading %}
    <div class="sgym-cards">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_link = block.settings.link
          assign card_image = block.settings.image
          if block.settings.product != blank
            if card_link == blank
              assign card_link = block.settings.product.url
            endif
            if card_image == blank
              assign card_image = block.settings.product.featured_image
            endif
          endif
        -%}
        <article class="sgym-content-card" {{ block.shopify_attributes }}>
          {%- if card_link != blank -%}
            <a href="{{ card_link }}">
          {%- endif -%}
          {% render 'sgym-picture',
            image: card_image,
            fallback: block.settings.fallback_asset,
            alt: block.settings.title,
            width: 1800,
            height: 1200,
            sizes: '(min-width: 750px) 50vw, 100vw'
          %}
          <div class="sgym-content-card__body">
            <h3>
              {{ block.settings.title }}
              {%- if block.settings.badge != blank -%}
                <span class="sgym-badge">• {{ block.settings.badge }}</span>
              {%- endif -%}
            </h3>
            {%- if block.settings.text != blank -%}
              <div class="rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
          {%- if card_link != blank -%}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "sGym content cards",
  "tag": "section",
  "class": "sgym-content-cards-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Combine & benefit!" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "archivo_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "inter_n4" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Bundled image filename" },
        { "type": "text", "id": "title", "label": "Title", "default": "Weight bench" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "COMING SOON" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe the product.</p>" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "product", "id": "product", "label": "Product", "info": "Optional. The card still uses the image and text above." }
      ]
    }
  ],
  "presets": [{ "name": "sGym content cards", "category": "sGym" }]
}
{% endschema %}
