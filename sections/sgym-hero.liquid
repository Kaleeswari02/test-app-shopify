{{ 'sgym.css' | asset_url | stylesheet_tag }}
{% render 'sgym-fonts' %}
<script src="{{ 'sgym-ui.js' | asset_url }}" defer="defer"></script>

<sgym-inline-video class="sgym sgym-section sgym-hero" data-autoplay="true">
  <div class="sgym-hero__media">
    {%- assign hero_alt = section.settings.image.alt | default: section.settings.heading -%}
    {% render 'sgym-video',
      video: section.settings.bg_video,
      image: section.settings.image,
      fallback: section.settings.fallback_asset,
      alt: hero_alt,
      autoplay: true,
      loop: true,
      muted: true,
      controls: false,
      width: 2400,
      height: 1022,
      loading: 'eager',
      sizes: '100vw',
      class: 'sgym-hero__img'
    %}
  </div>
  <div class="sgym-hero__shade" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  <a class="sgym-hero__scroll" href="#MainContent">
    <img src="{{ 'sgym-hero-divider-line.svg' | asset_url }}" width="55" height="22" alt="{{ section.settings.scroll_label | escape }}">
  </a>
  <div class="sgym-hero__content">
    <div class="sgym-hero__copy">
      {%- if section.settings.heading != blank -%}
        <h1 class="sgym-hero__title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="sgym-hero__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    <div class="sgym-hero__actions">
      <sgym-dialog>
        {%- if section.settings.button_label != blank -%}
          <button type="button" class="sgym-watch" data-sgym-open>
            {{ section.settings.button_label }}
          </button>
        {%- endif -%}
        <dialog class="sgym-dialog">
          <button type="button" class="sgym-dialog__close" data-sgym-close aria-label="{{ 'accessibility.close' | t }}">
            &times;
          </button>
          <div class="sgym-dialog__frame">
            {%- if section.settings.video != blank or section.settings.video_url != blank -%}
              {% render 'sgym-video',
                video: section.settings.video,
                video_url: section.settings.video_url,
                autoplay: true,
                loop: section.settings.loop,
                muted: false,
                controls: true,
                alt: section.settings.heading,
                class: 'sgym-dialog__video'
              %}
            {%- else -%}
              <p class="sgym-dialog__empty">{{ section.settings.empty_video }}</p>
            {%- endif -%}
          </div>
        </dialog>
      </sgym-dialog>
      <button type="button" class="sgym-hero__play" data-sgym-pause aria-pressed="true" aria-label="{% if section.settings.button_label != blank %}{{ section.settings.button_label | escape }}{% else %}{{ 'products.product.media.play_video' | t }}{% endif %}">
        <img class="is-pause" src="{{ 'sgym-play-circle-64.svg' | asset_url }}" width="64" height="64" alt="">
        <img class="is-play" src="{{ 'sgym-play-circle-play.svg' | asset_url }}" width="64" height="64" alt="">
        <svg class="sgym-hero__ring" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="29" pathLength="100" data-sgym-progress></circle></svg>
      </button>
    </div>
  </div>
</sgym-inline-video>

{% schema %}
{
  "name": "sGym hero",
  "tag": "section",
  "class": "sgym-hero-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Poster and fallback until a background video is uploaded." },
    { "type": "video", "id": "bg_video", "label": "Background video", "info": "Muted autoplay behind the hero. Upload the hero film in the theme editor." },
    { "type": "text", "id": "scroll_label", "label": "Scroll link label", "default": "Scroll" },
    { "type": "text", "id": "fallback_asset", "label": "Bundled image filename", "default": "sgym-hero-banner.jpg", "info": "Used until an image is picked. File must be in theme assets." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "sGym Pro" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "The next generation of strength training" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "WATCH VIDEO" },
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "video_url", "id": "video_url", "label": "Video URL", "accept": ["youtube", "vimeo"] },
    { "type": "checkbox", "id": "loop", "label": "Loop video", "default": false },
    { "type": "text", "id": "empty_video", "label": "Empty video message", "default": "Add a video in the theme editor." },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Overlay opacity", "default": 100 },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "archivo_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "inter_n4" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Top padding", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Bottom padding", "default": 0 }
  ],
  "presets": [{ "name": "sGym hero", "category": "sGym" }]
}
{% endschema %}
